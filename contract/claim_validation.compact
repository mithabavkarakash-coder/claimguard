// ClaimGuard - Zero-Knowledge Private Health Insurance Claim Validation
// Midnight Compact Contract

pragma language_version >= 0.14.0;

import CompactStandardLibrary;

export enum ClaimStatus {
    Unsubmitted,
    Approved,
    Rejected
}

export ledger claimStatus: ClaimStatus;
export ledger authorizedAmount: Uint<64>;
export ledger claimCommitment: Bytes<32>;
export ledger policyId: Bytes<32>;
export ledger processedCommitments: Set<Bytes<32>>;

constructor(initialPolicyId: Bytes<32>) {
    policyId = initialPolicyId;
    claimStatus = ClaimStatus.Unsubmitted;
    authorizedAmount = 0;
    claimCommitment = pad(32, "");
}

// Allowed procedure codes for policy reimbursement validation:
// 101: General Consultation, 102: Diagnostic Lab, 103: Radiology, 104: Preventive Screening
// 201: Outpatient Therapy, 202: Specialty Care
circuit isProcedureAllowed(code: Uint<32>): Boolean {
    return code == 101 || code == 102 || code == 103 || code == 104 || code == 201 || code == 202;
}

witness getPrivateClaimData(): Struct {
    diagnosisCode: Uint<32>,
    procedureCode: Uint<32>,
    claimAmount: Uint<64>,
    treatmentDetails: Bytes<64>,
    salt: Bytes<32>
};

export circuit validateClaim(
    commitment: Bytes<32>,
    deductibleLimit: Uint<64>
): Boolean {
    // 1. Ensure commitment has not been processed previously (Duplicate check)
    assert !processedCommitments.member(commitment) "Duplicate claim commitment detected";

    // 2. Fetch private witness inputs
    const privateData = getPrivateClaimData();

    // 3. Compute commitment from private inputs and verify integrity
    const computedCommitment = persistent_hash<Bytes<32>>(
        pad(32, "CLAIM_GUARD_V1"),
        privateData.diagnosisCode,
        privateData.procedureCode,
        privateData.claimAmount,
        privateData.salt
    );

    // 4. Circuit Validation Rules
    const validProcedure = isProcedureAllowed(privateData.procedureCode);
    const withinLimit = privateData.claimAmount <= deductibleLimit;
    const isValid = validProcedure && withinLimit;

    // 5. Update Public Ledger State without exposing private witness fields
    claimCommitment = commitment;
    processedCommitments.insert(commitment);

    if (isValid) {
        claimStatus = ClaimStatus.Approved;
        authorizedAmount = privateData.claimAmount;
    } else {
        claimStatus = ClaimStatus.Rejected;
        authorizedAmount = 0;
    }

    return isValid;
}
